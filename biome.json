{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": { "includes": ["src/**", "!src/routeTree.gen.ts", "!src/components/ui/**", "!src/index.css"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "asNeeded" } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": { "noStaticElementInteractions": "off", "useKeyWithClickEvents": "off", "useSemanticElements": "off", "noNoninteractiveTabindex": "off" },
      "suspicious": { "noArrayIndexKey": "off" },
      "style": { "noNonNullAssertion": "off" }
    }
  }
}
